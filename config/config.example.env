# Copy this file to /etc/loop-oracle.env on your Oracle Cloud VM.
# Fill in the OCIDs from your OCI Console before starting the timer.

OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
OCI_SUBNET_ID=ocid1.subnet.oc1..replace_me
# Leave OCI_IMAGE_ID blank to auto-pick the newest compatible image.
OCI_IMAGE_ID=
OCI_IMAGE_OS=Oracle Linux
OCI_IMAGE_OS_VERSION=
OCI_AVAILABILITY_DOMAIN=replace_me:REGION-AD-1

# Ampere free tier shape.
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1
OCI_MEMORY_GB=6

# OCI SDK config created by: oci setup config
OCI_CONFIG_FILE=/home/opc/.oci/config
OCI_PROFILE=DEFAULT

INSTANCE_NAME_PREFIX=auto-instance
ASSIGN_PUBLIC_IP=true

# Optional. Paste one full SSH public key on a single line.
SSH_PUBLIC_KEY=

# Delete the instance automatically if OCI reports launch failure.
DELETE_FAILED_INSTANCE=true
INSTANCE_WAIT_SECONDS=900
CAPACITY_RETRY_SUCCESS_EXIT=true
